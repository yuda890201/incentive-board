rules_version = '2';

// Firebase コンソール > Firestore Database > ルール にこの内容を貼り付けて公開してください。
// 匿名認証済みユーザーのみ読み書きを許可します（不特定多数からの書き込みを防ぐための最低限のルールです）。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
